{
  "name": "mais-toolbox",
  "version": "0.1.0",
  "description": "迈斯工具箱 — 跨电商平台商品搬家桌面工具(骨架)",
  "main": "dist-electron/main.js",
  "author": "ziyisj",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ziyisj.mais-toolbox",
    "productName": "MaisToolbox",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "directories": { "buildResources": "public" },
    "linux": { "target": ["AppImage"] },
    "mac": { "target": ["dmg"] },
    "win": { "target": ["nsis"] }
  }
}
